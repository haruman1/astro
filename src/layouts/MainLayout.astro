---
const { title = "MyApp" } = Astro.props;
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-900">
    <slot />
  </body>
</html>
