---
import '../styles/custom.css';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
     <title>{Astro.props.title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
   
  </head>

  <body>

    <!-- LEFT SIDE -->
    <div class="left">
      <div class="logo-kemenkes">
        <!-- <img src={LogoBBKK.src} alt="Logo Kemenkes" /> -->
      </div>

      <h1>Selamat Datang</h1>
      <h2 class="text-green">Aplikasi BBKK</h2>
      <p>Silakan masuk untuk melanjutkan</p>

      <!-- <img src={GirlImage.src} alt="Girl Illustration" class="girl" /> -->
    </div>

    <!-- RIGHT SIDE -->
    <div class="right">
      <div class="card">
        <h2>Login</h2>
        <form>
          <label>Email</label>
          <input type="email" placeholder="Masukkan email" />

          <label>Password</label>
          <input type="password" placeholder="Masukkan password" />

          <button type="submit">Masuk</button>
        </form>

        <a href="/register">
          Belum punya akun? <span class="text-green">Daftar</span>
        </a>
      </div>
    </div>

  </body>
</html>
